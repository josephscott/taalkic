{
	"name": "josephscott/taalkic",
	"description": "A PHP web framework built on Workerman.",
	"type": "library",
	"license": "MIT",
	"authors": [
		{
			"name": "Joseph Scott",
			"email": "joseph@josephscott.org"
		}
	],
	"require": {
		"php": ">=8.4",
		"workerman/workerman": ">=5.2.0",
		"nikic/fast-route": ">=1.3.0",
		"laminas/laminas-escaper": ">=2.18.0"
	},
	"require-dev": {
		"pestphp/pest": ">=4.7.0",
		"phpstan/phpstan": ">=2.2.0",
		"friendsofphp/php-cs-fixer": ">=3.95.2",
		"josephscott/phpcsfixer-config": ">=0.0.6"
	},
	"autoload": {
		"classmap": [
			"src/"
		],
		"files": [
			"src/helpers.php",
			"src/scope.php"
		]
	},
	"autoload-dev": {
		"classmap": [
			"tests/"
		]
	},
	"config": {
		"allow-plugins": false,
		"optimize-autoloader": true,
		"classmap-authoritative": true,
		"apcu-autoloader": true,
		"sort-packages": true,
		"preferred-install": "dist"
	}
}
